# Server-only secrets. Never expose these through VITE_* variables.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
# Optional comma-separated failover order. Defaults are already configured.
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
OPENAI_MODELS=gpt-5,gpt-5-mini

# Supabase browser and server configuration.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
